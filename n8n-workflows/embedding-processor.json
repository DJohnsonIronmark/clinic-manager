{
  "name": "Embedding Queue Processor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Run Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://xhyttombqrhqvnycyzlj.supabase.co/functions/v1/process-embedding-queue",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"batch_size\": 20\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "process-queue",
      "name": "Process Embedding Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-anon-key",
          "name": "Supabase Anon Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-processed",
              "leftValue": "={{ $json.processed }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-results",
      "name": "Has Processed Items?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://xhyttombqrhqvnycyzlj.supabase.co/functions/v1/process-embedding-queue",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"batch_size\": 20\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "process-more",
      "name": "Process More",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-anon-key",
          "name": "Supabase Anon Key"
        }
      }
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "id": "wait-between",
      "name": "Wait 2s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1200, 200]
    },
    {
      "parameters": {},
      "id": "done",
      "name": "Queue Empty",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, 400]
    }
  ],
  "connections": {
    "Run Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Process Embedding Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Embedding Queue": {
      "main": [
        [
          {
            "node": "Has Processed Items?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Processed Items?": {
      "main": [
        [
          {
            "node": "Process More",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Queue Empty",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process More": {
      "main": [
        [
          {
            "node": "Wait 2s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 2s": {
      "main": [
        [
          {
            "node": "Has Processed Items?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "instanceId": "clinic-manager"
  },
  "tags": [
    {
      "name": "AI",
      "id": "ai-tag"
    },
    {
      "name": "Embeddings",
      "id": "embeddings-tag"
    }
  ]
}
